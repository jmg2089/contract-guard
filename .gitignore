# 비밀값. .env 는 절대 커밋하지 않는다.
# .env.example 은 키 이름만 적힌 빈 껍데기이므로 커밋한다.
.env
.env.*
!.env.example

# 편집기가 만드는 백업본. 이름이 .env 로 시작하지 않아도 내용은 .env 그대로다.
*.save
*.bak
*.swp
*~

# 파이썬
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/

# 운영체제
.DS_Store
Thumbs.db

# 에디터
.idea/
.vscode/

# 분류기 모델은 빌드 시 학습해서 만든다 (sklearn 버전 불일치 방지)
data/clause_clf.joblib
data/doctype_clf.joblib

# 업로드된 계약서가 실수로 저장되는 것을 막는다.
# 지금 코드는 파일을 디스크에 쓰지 않지만, 누군가 디버깅하다 남길 수 있다.
uploads/
tmp/
*.pdf
!static/samples/*.pdf

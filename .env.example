# 이 파일을 .env 로 복사한 뒤 키를 채운다. .env 는 .gitignore 에 들어있어 커밋되지 않는다.
#
# 기본값은 dummy 다. 이 서비스는 외부 API 호출 0회로 동작하는 것이 설계이고,
# 룰 + 학습 분류기만으로 평가 F1 98.3% 가 나온다. LLM 은 선택 사항이다.
#
# 아래 LLM 설정은 실험용으로만 쓴다. 켜는 순간 계약서 본문이 외부 업체 서버로
# 전송된다는 점을 반드시 고려할 것. 근로계약서에는 이름·주소·급여가 들어 있다.
LLM_PROVIDER=dummy

# ── 실험용 1: Google Gemini (무료, 카드 불필요, 분당 15회 / 하루 1,500회) ──────
# 발급: https://aistudio.google.com/apikey
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.5-flash
# LLM_API_KEY=

# ── 2순위: Upstage Solar (가입 시 $10 크레딧, 한국어 특화, 대회 파트너사) ────────
# 발급: https://console.upstage.ai
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.upstage.ai/v1
# LLM_MODEL=solar-pro2
# LLM_API_KEY=

# ── 3순위: OpenAI (유료, 결제수단 등록 필요) ──────────────────────────────────
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=

# ── 키 없이 개발할 때 ────────────────────────────────────────────────────────
# LLM_PROVIDER=dummy

# ── 문의하기 메일 (강수현 님 문의 폼) ───────────────────────────────────
# 비워 두면 문의 기능만 동작하지 않고 나머지는 정상이다.
# SMTP_PASSWORD 는 절대 코드에 적지 말 것. Render 는 환경변수에 넣는다.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# 문의를 받을 우리 쪽 주소. 사용자가 입력한 주소로 보내지 않는다(스팸 악용 방지).
CONTACT_RECEIVER=

# 이 파일을 .env 로 복사한 뒤 키를 채운다. .env 는 .gitignore 에 들어있어 커밋되지 않는다.
# 셋 중 하나만 주석을 풀어 쓴다.

# ── 1순위: Google Gemini (무료, 카드 불필요, 분당 15회 / 하루 1,500회) ──────────
# 발급: https://aistudio.google.com/apikey
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=

# ── 2순위: Upstage Solar (가입 시 $10 크레딧, 한국어 특화, 대회 파트너사) ────────
# 발급: https://console.upstage.ai
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.upstage.ai/v1
# LLM_MODEL=solar-pro2
# LLM_API_KEY=

# ── 3순위: OpenAI (유료, 결제수단 등록 필요) ──────────────────────────────────
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=

# ── 키 없이 개발할 때 ────────────────────────────────────────────────────────
# LLM_PROVIDER=dummy
